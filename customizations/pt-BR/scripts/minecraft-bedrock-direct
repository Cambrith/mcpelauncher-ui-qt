#!/usr/bin/env bash

if command -v mcpelauncher-ui-qt >/dev/null 2>&1; then
    exec mcpelauncher-ui-qt --profile Default
elif command -v flatpak >/dev/null 2>&1 && \
     flatpak info io.mrarm.mcpelauncher >/dev/null 2>&1; then
    exec flatpak run io.mrarm.mcpelauncher --profile Default
else
    echo "Minecraft Bedrock Launcher não encontrado." >&2
    exit 1
fi

#!/usr/bin/env python3
"""Abre o Flatpak io.mrarm.mcpelauncher usando, quando válidas, as cópias traduzidas locais.

Cada personalização é validada por SHA-256 contra o binário original instalado.
Se algo não bater (por exemplo, após uma atualização do Flatpak), usa o original.
"""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

APP_ID = 'io.mrarm.mcpelauncher'
DATA = Path.home() / '.var/app' / APP_ID / 'data'
FLATPAK = shutil.which('flatpak') or '/usr/bin/flatpak'


def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def notify(message):
    print('Minecraft: ' + message, file=sys.stderr)
    if shutil.which('notify-send'):
        subprocess.run(['notify-send', 'Minecraft', message], check=False)


def valid(base, binary, location):
    """True se manifest.json de `base` corresponde ao original e à cópia de `binary`."""
    manifest = json.loads((base / 'manifest.json').read_text())
    return (sha256(Path(location) / 'files/bin' / binary) == manifest['source_sha256']
            and sha256(base / 'bin' / binary) == manifest['patched_sha256']
            and all(sha256(base.parent / rel) == expected
                    for rel, expected in manifest.get('external_files', {}).items()))


try:
    location = subprocess.check_output([FLATPAK, 'info', '--show-location', APP_ID],
                                       text=True, stderr=subprocess.DEVNULL).strip()
except (OSError, subprocess.SubprocessError):
    notify('Flatpak io.mrarm.mcpelauncher não encontrado.')
    sys.exit(1)

# Interface do launcher (opcional: só existe se uma cópia local foi preparada).
command = 'mcpelauncher-ui-qt'
ui_base = DATA / 'minecraft-ui-localization'
if (ui_base / 'manifest.json').exists():
    try:
        if valid(ui_base, 'mcpelauncher-ui-qt', location):
            command = '/var/data/minecraft-ui-localization/bin/mcpelauncher-ui-qt'
        else:
            notify('A versão do launcher mudou. A interface original será usada.')
    except (OSError, ValueError, KeyError):
        notify('A personalização local da interface está indisponível. Abrindo o launcher original.')

# Menus nativos do jogo (gerados pelo install.sh a partir do binário do próprio usuário).
game_options = []
game_base = DATA / 'minecraft-game-menu-localization'
if (game_base / 'manifest.json').exists():
    try:
        if valid(game_base, 'mcpelauncher-client', location):
            game_options = ['--env=PATH=/var/data/minecraft-game-menu-localization/bin:/app/bin:/usr/bin']
        else:
            notify('O cliente do jogo mudou. Os menus originais (em inglês) serão usados.')
    except (OSError, ValueError, KeyError):
        notify('A tradução local dos menus do jogo está indisponível. Usando o cliente original.')

# Não deixe sobreposições temporárias de locale do terminal mascararem o LANG do Flatpak.
environment = os.environ.copy()
environment.pop('LC_ALL', None)
environment.pop('LC_CTYPE', None)
args = [FLATPAK, 'run', '--command=' + command, *game_options,
        '--file-forwarding', APP_ID, '@@u', *sys.argv[1:], '@@']
os.execve(FLATPAK, args, environment)
